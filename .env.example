# Local dev (old computer, everything on localhost):
#   DATABASE_URL=postgresql://user:password@localhost:5432/liketexts
#   REDIS_URL=redis://localhost:6379/0
#   CELERY_BROKER_URL=redis://localhost:6379/1
#   CELERY_RESULT_BACKEND=redis://localhost:6379/2
#
# Docker Compose (this computer, Orbstack) — service hostnames, not localhost:
#   DATABASE_URL=postgresql://liketexts:liketexts@db:5432/liketexts
#   REDIS_URL=redis://redis:6379/0
#   CELERY_BROKER_URL=redis://redis:6379/1
#   CELERY_RESULT_BACKEND=redis://redis:6379/2
#
# NOTE: docker-compose.yml already sets the Docker defaults via `environment`,
# so you only need a .env file (copied from this example) to override secrets
# and non-default config. Anything set in .env wins over compose defaults for
# that variable — keep Docker hostnames (db/redis) when running in Compose.

# --- Database ---
DATABASE_URL=postgresql://liketexts:liketexts@db:5432/liketexts

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- App ---
APP_ENV=development
SECRET_KEY=dev-secret-change-in-production
API_PREFIX=/api/v1

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Subscription economics (config-driven) ---
SUBSCRIPTION_MONTHLY_PRICE_EUR=9.95
ALLOCATION_SLOTS_PER_SUBSCRIPTION=5
CHANGE_CREDITS_PER_BILLING_CYCLE=2

# --- Email (stub log v1, no SMTP needed) ---
EMAIL_BATCH_SIZE=100
EMAIL_SENDER_ADDRESS=noreply@liketexts.local

# --- Payments (mock v1, Stripe later) ---
PAYMENT_GATEWAY=mock
SUBSCRIPTION_PRICE_ID=price_monthly_eur_995

# --- Rate limiting (backed by REDIS_URL) ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# --- Avatars (local file storage v1) ---
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_MAX_UPLOAD_MB=2
